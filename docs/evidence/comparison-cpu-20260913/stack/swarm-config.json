      "base_url": "http://127.0.0.1:45815/swarm/v1"
    }
  },
  "swarms": {
    "kyc-ensemble": {
      "generators": [
        {
          "provider": "local",
          "model": "qwen3-4b-instruct-2507",
          "max_tokens": 512,
          "temperature": 0
        },
        {
          "provider": "local",
          "model": "qwen3-4b-instruct-2507",
          "max_tokens": 512,
          "temperature": 0.4
        }
      ],
      "merger": {
        "provider": "local",
        "model": "qwen3-4b-instruct-2507",
        "max_tokens": 512,
        "temperature": 0
      },
      "min_success": 2,
      "merger_failure": "error"
